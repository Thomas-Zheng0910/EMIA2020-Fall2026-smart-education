{
  "name": "collaborative-course-notebook",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:local": "PORT=4312 API_PORT=4312 WEB_PORT=5174 npm run dev",
    "build": "tsc --noEmit && vite build",
    "serve": "node scripts/serve.mjs",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "demo:hardcoded": "tsx scripts/hardcoded-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "seed": "tsx --env-file-if-exists=.env server/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "katex": "^0.18.10",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
