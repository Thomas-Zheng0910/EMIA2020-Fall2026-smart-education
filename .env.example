# Official DeepSeek works out of the box: deepseek-flash reads images, so no separate OCR model is needed.
# Without these the app still runs, but digests, note sharing, Explain and Quiz return a clear "AI not configured" error.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
PORT=4310
DATA_DIR=./data
# Seconds of inactivity before a page is re-read and shared (milliseconds).
INDEX_DELAY_MS=6000
# Optional exact public origins behind Cloudflare Tunnel (comma-separated).
ALLOWED_ORIGINS=
